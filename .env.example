# Supabase — copy to `.env.local` for local dev, and add the same vars in Vercel.
# Project Settings → API in your Supabase dashboard.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Leave these unset to run the app in local-only "guest" mode (no accounts,
# leagues or cloud save) — handy for previewing before the backend is wired up.
